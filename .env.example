# Database (matches docker-compose defaults for local dev)
DATABASE_URL="postgresql://reports:reports@localhost:5432/reports"

# LAN base URL for password-set links (e.g. http://192.168.1.50:3000)
APP_URL="http://localhost:3000"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"

# Single-org internal deployment (multi-tenant SaaS later)
SINGLE_TENANT_MODE="true"

# Local filesystem uploads (Docker volume mount at /data/uploads)
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_BYTES="10485760"

# Display timezone for dates (DB stores UTC)
TZ="UTC"

# Docker Compose production overrides (docker-compose.prod.yml)
# POSTGRES_USER=reports
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=reports
# APP_PORT=3000
